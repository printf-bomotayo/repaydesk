# Copy to .env and change every password. .env is git-ignored; never commit it.

REPAYDESK_ENV=local
BANK_NAME=Demo Microfinance Bank

# Postgres: one superuser for setup, one role per system
POSTGRES_PASSWORD=change-me-postgres
FINERACT_DB_PASSWORD=change-me-fineract
ODOO_DB_PASSWORD=change-me-odoo
REPAYDESK_DB_PASSWORD=change-me-repaydesk

# Fineract: tenant master password, and the admin login the seed uses to set everything up
# (the demo default is mifos/password; it's also the login for Fineract's staff screens)
FINERACT_MASTER_PASSWORD=change-me-master
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
# The seed creates these. Read only: the API, the borrower directory and rule matching.
# Repayments only: the posting gateway, the one writer (ADR 0002). Fineract wants 12+ characters
# with upper and lower case, a digit and a symbol; scripts/dev.py generates such passwords.
FINERACT_READ_USERNAME=repaydesk-read
FINERACT_READ_PASSWORD=change-me-fineractread
FINERACT_GATEWAY_USERNAME=repaydesk-gateway
FINERACT_GATEWAY_PASSWORD=change-me-fineractgateway

# Odoo: the ledger's admin login (a new database starts as admin/admin). The seed and the posting
# gateway use it; nothing else in Repaydesk writes to the ledger.
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
# A login that can read the books and change nothing, for the ledger MCP server. The seed creates it.
ODOO_READ_USERNAME=repaydesk-read
ODOO_READ_PASSWORD=change-me-odooread

# Synthetic data: how many borrowers, and the random seed (same seed, same book)
SEED_BORROWERS=2000
SEED_RANDOM=42

# The investigator agent (milestone 3, ADR 0009). MODEL_PROVIDER is anthropic (the Claude API, with
# ANTHROPIC_API_KEY) or bedrock (Amazon Bedrock, with AWS_REGION and the usual AWS credentials).
# Without a key the agent doesn't run; everything else does, and the tests use a scripted model.
ANTHROPIC_API_KEY=
MODEL_PROVIDER=anthropic
AWS_REGION=
INVESTIGATOR_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
# Below this confidence a match waits in suspense for a person instead of being proposed.
AGENT_MIN_CONFIDENCE=0.7

# Optional self-hosted Langfuse (compose.langfuse.yaml). scripts/dev.py fills these in.
LANGFUSE_DB_PASSWORD=change-me-langfusedb
LANGFUSE_SALT=change-me-salt
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth
LANGFUSE_CLICKHOUSE_PASSWORD=change-me-clickhouse
LANGFUSE_MINIO_PASSWORD=change-me-minio
LANGFUSE_REDIS_PASSWORD=change-me-redis
LANGFUSE_PUBLIC_KEY=pk-lf-change-me-public
LANGFUSE_SECRET_KEY=sk-lf-change-me-secret
LANGFUSE_ADMIN_PASSWORD=change-me-admin
# base64 of "<public key>:<secret key>", for the collector's OTLP export
LANGFUSE_AUTH=

# Staff sign-in for the review queue. The demo reviewers (amaka, kunle: officers; tunde:
# supervisor; hadiza: auditor) share this password. SESSION_SECRET signs their sign-in tokens.
STAFF_DEMO_PASSWORD=change-me-staff
SESSION_SECRET=change-me-session

# Payment provider webhook signing secret
PAYRAIL_WEBHOOK_SECRET=change-me-payrail

# The Fineract address a browser uses (the Mifos X web app calls it from the browser)
FINERACT_PUBLIC_URL=http://127.0.0.1:18080
